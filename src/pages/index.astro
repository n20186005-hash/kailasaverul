---
import '../styles/global.css';
const site = Astro.site;
const canonical = site ? new URL('/', site).toString() : undefined;
const ogImage = site ? new URL('/images/og.jpg', site).toString() : undefined;
const mapUrl = 'https://www.google.com/maps?q=Ellora%2C%20Verul%2C%20Maharashtra%20431102%2C%20India&output=embed&hl=mr';
const photos = {
  hero: 'https://thumb.wikimedia.org/wikipedia/commons/thumb/8/88/Kailasa_temple_overview%2C_Ellora.jpg/1280px-Kailasa_temple_overview%2C_Ellora.jpg',
  elephant: 'https://thumb.wikimedia.org/wikipedia/commons/thumb/3/3a/Ellora_Caves%2C_India%2C_Kailasanatha_Temple_2.jpg/1280px-Ellora_Caves%2C_India%2C_Kailasanatha_Temple_2.jpg',
  base: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Ellora%20cave%2C%20Kailasa%20Temple%20-%20multiple%20elephants%20at%20base.jpg?width=1280'
};
const attraction = {
  '@context':'https://schema.org','@type':['TouristAttraction','HinduTemple'],
  name:'Rashtrakuta Era Shree Kailas Mandir (Verul)',
  alternateName:'राष्ट्रकूटकालीन श्री कैलास मंदिर, वेरूळ',
  address:{'@type':'PostalAddress',streetAddress:'Ellora',addressLocality:'Verul',addressRegion:'Maharashtra',postalCode:'431102',addressCountry:'IN'},
  geo:{'@type':'GeoCoordinates',latitude:20.023742,longitude:75.178939},
  openingHoursSpecification:[{'@type':'OpeningHoursSpecification',dayOfWeek:['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],opens:'09:00',closes:'17:00'}],
  aggregateRating:{'@type':'AggregateRating',ratingValue:'4.8',reviewCount:'10104',bestRating:'5',worstRating:'1'},
  ...(canonical ? {url:canonical} : {})
};
const faq = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:[
 {'@type':'Question',name:'कैलास मंदिर एलोरा लेण्यांमध्ये कोणत्या क्रमांकाचे आहे?',acceptedAnswer:{'@type':'Answer',text:'कैलास मंदिर हे वेरूळ/एलोरा लेणी समूहातील लेणे क्रमांक १६ आहे.'}},
 {'@type':'Question',name:'भेटीसाठी किती वेळ राखावा?',acceptedAnswer:{'@type':'Answer',text:'फक्त कैलास मंदिर नीट पाहण्यासाठी साधारण १.५–२ तास राखणे सोयीचे; संपूर्ण एलोरा समूहासाठी अर्धा दिवस किंवा अधिक वेळ उपयुक्त ठरतो.'}},
 {'@type':'Question',name:'तिकीट व वेळा कुठे तपासाव्यात?',acceptedAnswer:{'@type':'Answer',text:'दर आणि प्रवेश वेळा बदलू शकतात. प्रवासाच्या दिवशी ASI/महाराष्ट्र पर्यटनाच्या अधिकृत माहितीत ताजे तपशील तपासा.'}},
 {'@type':'Question',name:'पार्किंग उपलब्ध आहे का?',acceptedAnswer:{'@type':'Answer',text:'एलोरा प्रवेश परिसरात वाहनांसाठी पार्किंगची व्यवस्था आढळते; गर्दीच्या दिवशी लवकर पोहोचणे सोयीचे.'}}
]};
---
<!doctype html>
<html lang="mr">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
<title>श्री कैलास मंदिर, वेरूळ — राष्ट्रकूटकालीन एकशिळा स्थापत्य</title>
<meta name="description" content="वेरूळच्या लेणे क्रमांक १६ मधील श्री कैलास मंदिर: इतिहास, शिल्पकला, तिकीट, पार्किंग, वाहतूक, जवळची ठिकाणे आणि प्रवास नियोजन." />
{canonical && <link rel="canonical" href={canonical} />}
<meta property="og:type" content="website"/><meta property="og:locale" content="mr_IN"/><meta property="og:title" content="श्री कैलास मंदिर, वेरूळ"/><meta property="og:description" content="एकाच बेसॉल्ट खडकातून घडवलेले कैलास मंदिर — वेरूळचे लेणे क्रमांक १६."/>
{canonical && <meta property="og:url" content={canonical}/>} {ogImage && <meta property="og:image" content={ogImage}/>} 
<link rel="icon" href="/icons/favicon.svg" type="image/svg+xml"/><link rel="icon" href="/icons/favicon-32.png" sizes="32x32"/><link rel="icon" href="/icons/favicon-16.png" sizes="16x16"/><link rel="apple-touch-icon" href="/icons/favicon-180.png"/>
<script type="application/ld+json" set:html={JSON.stringify(attraction)}></script><script type="application/ld+json" set:html={JSON.stringify(faq)}></script>
<script async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
<script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-HXM22WWPKP');</script>
</head>
<body class="texture">
<header class="shell" style="display:flex;justify-content:space-between;align-items:center;padding:1rem 0;gap:1rem"><a href="#top"><img src="/icons/logo.svg" alt="श्री कैलास मंदिर" width="240" height="72"/></a><nav style="display:flex;gap:.9rem;flex-wrap:wrap;font-size:.93rem"><a href="#visit">भेट नियोजन</a><a href="#around">आजूबाजूला</a><a href="#faq">FAQ</a></nav></header>
<main id="top">
<section class="shell" style="padding:2rem 0 5rem;display:grid;grid-template-columns:1.05fr .95fr;gap:2rem;align-items:center">
 <div><div class="kicker">वेरूळ · महाराष्ट्र · लेणे क्रमांक १६</div><h1 style="font-family:serif;font-size:clamp(3rem,7vw,6.4rem);line-height:.96;margin:.7rem 0 1.2rem">दगडातून<br/>उलगडलेला <span style="color:#d7b66f">कैलास</span></h1><p style="font-size:1.16rem;color:#d8cfbd;max-width:46rem">राष्ट्रकूट काळातील श्री कैलास मंदिर हे एलोरा समूहातील सर्वात प्रसिद्ध एकशिळा स्थापत्यांपैकी एक. मंदिराचा मोठा भाग एकाच बेसॉल्ट खडकातून वरून खाली कोरत घडवला गेला.</p><div style="display:flex;gap:.7rem;flex-wrap:wrap;margin-top:1.5rem"><a class="btn" href="#visit">भेट आखा</a><a class="btn btn-ghost" href="https://maps.app.goo.gl/uXVXeifZKjAZLyCG9" rel="noopener">Google Maps</a></div><div style="display:flex;gap:.65rem;flex-wrap:wrap;margin-top:1.6rem"><span class="badge">★ 4.8 · Google</span><span class="badge">UNESCO Ellora समूह</span><span class="badge">राष्ट्रकूट · कृष्ण I</span></div></div>
 <figure class="photo-frame" style="aspect-ratio:4/5;margin:0"><img class="photo" src={photos.hero} alt="वेरूळ येथील कैलास मंदिराचे अंगण आणि दगडी वास्तू" fetchpriority="high"/><figcaption style="padding:.65rem 1rem;color:#bdb29b;font-size:.8rem">प्रत्यक्ष छायाचित्र · Wikimedia Commons · CC BY-SA 4.0</figcaption></figure>
</section>
<section class="section"><div class="shell" style="display:grid;grid-template-columns:.8fr 1.2fr;gap:2rem"><div><div class="kicker">वारसा</div><h2 style="font-family:serif;font-size:2.6rem;margin:.4rem 0">एक मंदिर, एक पर्वत, हजारो तपशील</h2></div><div><p>UNESCO च्या वर्णनात कैलास (लेणे १६) हे एलोऱ्याच्या ब्राह्मणिक गटातील महत्त्वाचे स्मारक मानले आहे. शिल्पांमध्ये शिवपरंपरेतील कथानके, रावणाने कैलास उचलण्याचा प्रसंग, महाकाव्यांतील दृश्ये, स्तंभ आणि मंडप यांची समृद्ध मांडणी दिसते.</p><div style="display:grid;grid-template-columns:repeat(3,1fr);gap:.8rem;margin-top:1.4rem"><div class="card"><b>लेणे १६</b><br/><small>एलोरा समूहातील कैलास</small></div><div class="card"><b>७–१० वे शतक</b><br/><small>ब्राह्मणिक लेण्यांचा कालखंड</small></div><div class="card"><b>कृष्ण I</b><br/><small>मुख्य बांधणीशी जोडला जाणारा राष्ट्रकूट राजा</small></div></div></div></div></section>
<section class="section"><div class="shell" style="display:grid;grid-template-columns:1fr 1fr;gap:1rem"><figure class="photo-frame" style="aspect-ratio:16/10;margin:0"><img class="photo" src={photos.elephant} alt="कैलास मंदिराच्या तळभागावरील दगडी हत्तींच्या शिल्पांची रांग" loading="lazy"/></figure><figure class="photo-frame" style="aspect-ratio:16/10;margin:0"><img class="photo" src={photos.base} alt="कैलास मंदिराच्या तळाशी कोरलेली हत्तींची शिल्परांग" loading="lazy"/></figure></div></section>
<section class="section" id="visit"><div class="shell"><div class="kicker">भेट नियोजन</div><h2 style="font-family:serif;font-size:2.7rem;margin:.4rem 0 1.6rem">जाण्यापूर्वीची उपयोगी माहिती</h2><div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1rem">
<div class="card"><h3>तिकीट / शुल्क</h3><p>तिकीट दर बदलू शकतात. महाराष्ट्र पर्यटनाच्या पानावर भारतीय व परदेशी पाहुण्यांसाठी वेगवेगळे दर नमूद आहेत; प्रवासाच्या दिवशी ASI/अधिकृत तिकीट व्यवस्थेत ताजे दर तपासा.</p></div>
<div class="card"><h3>उघडण्याची वेळ</h3><p>अधिकृत पर्यटन माहितीत साधारण <b>सकाळी ९ ते संध्याकाळी ५</b> अशी भेट वेळ दिली आहे. सार्वजनिक सुट्ट्या/देखभाल यांमुळे बदल शक्य.</p></div>
<div class="card"><h3>सर्वोत्तम काळ</h3><p><b>ऑक्टोबर–मार्च</b> हवामान तुलनेने सुखद. पावसाळ्यात परिसर हिरवा दिसतो, पण दगडी पायऱ्या घसरड्या असू शकतात.</p></div>
<div class="card"><h3>किती वेळ द्यावा?</h3><p>कैलास मंदिरासाठी १.५–२ तास राखा. संपूर्ण ३४ लेणी पाहायची असल्यास अर्धा दिवस किंवा त्याहून अधिक वेळ द्या.</p></div>
<div class="card"><h3>पार्किंग</h3><p>मुख्य एलोरा प्रवेश परिसरात वाहन पार्किंगची व्यवस्था आहे. सप्ताहांत/उत्सवकाळात गर्दी वाढू शकते; सकाळी लवकर पोहोचणे सोयीचे.</p></div>
<div class="card"><h3>काय बरोबर न्यावे?</h3><p>चांगली पकड असलेले शूज, पाणी, टोपी आणि हलकी बॅग. शिल्पांना हात लावणे किंवा संरक्षित भागात प्रवेश टाळा.</p></div>
</div></div></section>
<section class="section"><div class="shell" style="display:grid;grid-template-columns:1fr 1fr;gap:1.2rem;align-items:start"><div><div class="kicker">सविस्तर वाहतूक</div><h2 style="font-family:serif;font-size:2.6rem">वेरूळपर्यंत कसे पोहोचाल?</h2><div class="card"><p><b>छत्रपती संभाजीनगरहून:</b> एलोरा साधारण ३० किमी अंतरावर असून बस, टॅक्सी किंवा खासगी वाहनाने जाता येते.</p><p><b>रेल्वे:</b> छत्रपती संभाजीनगर (Aurangabad/AWB) हे महत्त्वाचे रेल्वे केंद्र.</p><p><b>विमान:</b> Chhatrapati Sambhaji Nagar Airport (IXU) कडून टॅक्सी/रस्ते वाहतूक उपलब्ध.</p><p><b>स्थानिक हालचाल:</b> लेणी समूह मोठा आहे; अधिकृत परिसरातील अंतर्गत वाहन/शटल सेवा उपलब्ध असल्यास त्याचा उपयोग करा.</p></div></div><div class="photo-frame" style="min-height:420px"><iframe title="श्री कैलास मंदिर, वेरूळ नकाशा" src={mapUrl} lang="mr" width="100%" height="420" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div></div></section>
<section class="section" id="around"><div class="shell"><div class="kicker">आजूबाजूचा दिवस</div><h2 style="font-family:serif;font-size:2.7rem;margin:.4rem 0 1.5rem">जवळची ठिकाणे आणि चव</h2><div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem"><div class="card"><h3>जवळची आकर्षणे</h3><p><b>घृष्णेश्वर ज्योतिर्लिंग:</b> एलोराच्या अगदी जवळचे महत्त्वाचे शिवमंदिर.</p><p><b>भद्रा मारुती, खुलताबाद:</b> काही किलोमीटर अंतरावरील प्रसिद्ध हनुमान मंदिर.</p><p><b>देवगिरी / दौलताबाद किल्ला:</b> मध्यमयुगीन संरक्षणरचनेसाठी ओळखला जाणारा डोंगरी किल्ला.</p><p><b>बीबी का मकबरा:</b> छत्रपती संभाजीनगरमधील प्रसिद्ध मकबरा.</p></div><div class="card"><h3>जवळचे खाणे</h3><p>एलोरा प्रवेशमार्ग आणि वेरूळ गावात महाराष्ट्रियन नाश्ता, थाळी, पोहे, मिसळ, भाकरी-भाजी, चहा आणि साधे उत्तर भारतीय पर्याय मिळतात.</p><p>लांब दिवसासाठी हलके जेवण घ्या; पाणी पुरेसे ठेवा. धार्मिक स्थळांच्या आसपास स्थानिक आचारसंहिता पाळा.</p></div></div></div></section>
<section class="section" id="faq"><div class="shell" style="max-width:900px"><div class="kicker">FAQ</div><h2 style="font-family:serif;font-size:2.7rem">सामान्य प्रश्न</h2><details class="card"><summary>हे मंदिर एलोरा समूहात कुठे आहे?</summary><p>हे लेणे क्रमांक १६ आहे आणि मुख्य प्रवेशानंतर सहज गाठता येते.</p></details><details class="card" style="margin-top:.7rem"><summary>फोटो काढता येतात का?</summary><p>सामान्य पर्यटक छायाचित्रण बहुतेक खुल्या भागांत करता येते; ट्रायपॉड, व्यावसायिक उपकरणे किंवा विशिष्ट संरक्षित भागांसाठी स्थानिक नियम तपासा.</p></details><details class="card" style="margin-top:.7rem"><summary>मार्गदर्शक घ्यावा का?</summary><p>शिल्पकथानके आणि स्थापत्य समजून घ्यायचे असल्यास ASI-मान्यताप्राप्त/अधिकृत मार्गदर्शक उपयुक्त ठरतो.</p></details><details class="card" style="margin-top:.7rem"><summary>लहान मुलांसह/ज्येष्ठांसह भेट देता येते का?</summary><p>मुख्य अंगणात चालणे शक्य असले तरी पायऱ्या, असमान दगडी पृष्ठभाग आणि उष्णता लक्षात घ्या. विश्रांतीसाठी वेळ ठेवा.</p></details></div></section>
<section class="section"><div class="shell"><div class="card"><h3>स्रोत व छायाचित्र परवाने</h3><p style="font-size:.9rem;color:#cfc5b1">ऐतिहासिक/भेट माहिती: UNESCO World Heritage Centre, Maharashtra Tourism, Incredible India. छायाचित्रे: Ms Sarah Welch (CC BY-SA 4.0), Vyacheslav Argenberg (CC BY 4.0), Prof Ranga Sai (CC BY-SA 4.0), Wikimedia Commons. प्रतिमा त्यांच्या परवान्यांनुसार वापरल्या आहेत.</p></div></div></section>
</main>
<footer class="section"><div class="shell" style="display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap"><span>श्री कैलास मंदिर · वेरूळ</span><span style="color:#aaa18f">हे संकेतस्थळ अनधिकृत प्रवासी माहिती मार्गदर्शक आहे; ASI, UNESCO किंवा मंदिर प्रशासनाशी अधिकृत संबंध नाही.</span></div></footer>
</body></html>
