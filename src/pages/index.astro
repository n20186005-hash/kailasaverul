---
import '../styles/global.css';
import Weather from '../components/Weather.astro';
import {sections,faq,sources,checked} from '../data/guide';
const origin='https://kailasaverul.com',canonical=origin+'/';
const title='Kailasa Temple Ellora (Cave 16) | वेळा, तिकीट व भेट';
const description='कैलास मंदिर, वेरूळ — Ellora Cave 16: ASI opening and ticket listings, temple versus cave-complex location, regional weather, historical architecture and dated sources.';
const image=origin+'/images/kailasa-social.jpg';const photoAlt='२०१६ मधील कैलासच्या वरच्या कोरीव भागाचा ऐतिहासिक फोटो, कापलेला / Cropped historical 2016 view of Kailasa’s upper rock-cut facades';
const schema=[{'@context':'https://schema.org','@type':['TouristAttraction','HinduTemple'],'@id':canonical+'#attraction',name:'Kailasa Temple (Cave 16), Ellora / कैलास मंदिर, वेरूळ',alternateName:['Kailash Temple','Kailasanatha','Shree Kailas Mandir, Verul'],url:canonical,image:[origin+'/images/kailasa-upper-1600.jpg'],containedInPlace:{'@type':'TouristAttraction',name:'Ellora Caves',sameAs:sources.unesco,geo:{'@type':'GeoCoordinates',latitude:20.02639,longitude:75.17917}}},{'@context':'https://schema.org','@type':'WebSite','@id':canonical+'#website',name:'Kailasa Verul independent guide',url:canonical,inLanguage:['mr','en']},{'@context':'https://schema.org','@type':'WebPage','@id':canonical+'#webpage',url:canonical,name:title,description,inLanguage:['mr','en'],about:{'@id':canonical+'#attraction'},isPartOf:{'@id':canonical+'#website'}},{'@context':'https://schema.org','@type':'FAQPage','@id':canonical+'#faq',mainEntity:faq.flatMap(f=>[f.mr,f.en].map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}})))}];
const nav=[['guide','ओळख / Identity'],['visit','तिकीट / Access'],['location','नकाशा / Location'],['getting-here','वाहतूक / Travel'],['weather','हवामान / Weather'],['faq','प्रश्न / FAQ'],['sources','स्रोत / Sources']];
---
<!doctype html><html lang="mr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><meta name="robots" content="index,follow,max-image-preview:large"/><link rel="canonical" href={canonical}/><meta property="og:type" content="website"/><meta property="og:locale" content="mr_IN"/><meta property="og:locale:alternate" content="en_US"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={image}/><meta property="og:image:type" content="image/jpeg"/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content={photoAlt}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={image}/><meta name="twitter:image:alt" content={photoAlt}/><meta name="theme-color" content="#171713"/><link rel="manifest" href="/manifest.webmanifest"/><link rel="icon" href="/icons/favicon.svg"/>{schema.map(x=><script type="application/ld+json" is:inline set:html={JSON.stringify(x)}/>)}
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script><script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','G-HXM22WWPKP');</script>
</head><body><a href="#main" class="skip">मुख्य मजकूर / Skip to content</a><header><div class="shell header-shell"><a href="#top" class="brand"><img src="/icons/logo.svg" alt="कैलास वेरूळ मार्गदर्शक / Kailasa Verul guide" width="240" height="72"/></a><details class="menu"><summary>सूची / Menu ▾</summary><nav aria-label="विभाग / Sections">{nav.map(([id,label])=><a href={'#'+id}>{label}</a>)}</nav></details><a class="plain-link" href="#privacy">गोपनीयता / Privacy</a></div></header>
<main id="main"><section class="section hero" id="top"><div class="shell"><div class="kicker">वेरूळ · महाराष्ट्र · भारत / Verul · Maharashtra · India</div><h1>कैलास मंदिर · लेणे १६ <span lang="en">Kailasa Temple · Ellora Cave 16</span></h1><p class="lead">एकशिळा वारसा समजून घ्या; एलोरा समूह, प्रवेश आणि मंदिराची ओळख वेगळी ठेवा.</p><p lang="en" class="lead">Understand the monolithic monument while distinguishing the temple, the cave ensemble and admission arrangements.</p><p><a class="btn" href="#visit">भेट व तिकीट / Access checks</a> <a class="btn btn-ghost" href={sources.maps} target="_blank" rel="noopener noreferrer">Google Maps ↗</a></p><p class="badge">★ 4.8 / 5 · 10,175 Google Maps · {checked}</p><p class="small">हाताने तपासलेली दिनांकित झलक; आपोआप बदलत नाही. / <span lang="en">Manual dated snapshot, not automatically updated.</span></p><figure class="photo-frame"><img class="photo" src="/images/kailasa-upper-1600.jpg" srcset="/images/kailasa-upper-800.jpg 800w,/images/kailasa-upper-1600.jpg 1600w" sizes="(max-width:1200px) 100vw,1180px" width="1600" height="588" alt={photoAlt} fetchpriority="high"/><figcaption>Ms Sarah Welch · 2016-09-12 · CC BY-SA 4.0 · <a href="#image-credits">ऐतिहासिक वरचा भाग; स्रोत व बदल / Historical upper detail; source & changes</a></figcaption></figure></div></section>
{sections.map(s=><section class="section" id={s.id}><div class="shell"><h2>{s.mr}<span lang="en">{s.en}</span></h2>{s.paragraphs.map(p=><div class="language-pair"><p lang="mr">{p.mr}</p><p lang="en">{p.en}</p></div>)}{s.id==='visit'&&<><div class="table-wrap"><table><caption>ASI यादी / ASI listed rates · consulted {checked}</caption><thead><tr><th>पात्रता / Category</th><th>स्थळी / Counter</th><th>ऑनलाइन / Online</th></tr></thead><tbody><tr><td>भारतीय, SAARC व BIMSTEC / Indian, SAARC & BIMSTEC</td><td>₹40</td><td>₹35</td></tr><tr><td>इतर परदेशी / Other foreign visitors</td><td>₹600</td><td>₹550</td></tr><tr><td>१५ वर्षांखालील मुले / Children below 15</td><td colspan="2">ASI सूचीप्रमाणे मोफत / Free in ASI listing</td></tr></tbody></table></div><p><a href={sources.asi} target="_blank" rel="noopener noreferrer">ASI मूळ माहिती / Source listing ↗</a> · <a href={sources.tickets} target="_blank" rel="noopener noreferrer">अधिकृत तिकीट सेवा / Official ticket service ↗</a></p></>}{s.id==='location'&&<p><a class="btn" href={sources.maps} target="_blank" rel="noopener noreferrer">Google Maps संदर्भ / Reference ↗</a> · <a href={sources.unesco}>UNESCO property reference ↗</a></p>}{s.id==='reviews'&&<p><a href={sources.maps}>मूळ अभिप्राय / Original Google Maps listing ↗</a></p>}</div></section>)}
<Weather/>
<section class="section" id="faq"><div class="shell"><h2>प्रश्नोत्तरे <span lang="en">Frequently asked questions</span></h2>{faq.map(f=><details class="card faq"><summary><span lang="mr">{f.mr[0]}</span><span lang="en">{f.en[0]}</span></summary><p lang="mr">{f.mr[1]}</p><p lang="en">{f.en[1]}</p></details>)}</div></section>
<section class="section" id="sources"><div class="shell"><h2>माहितीचे स्रोत <span lang="en">Sources and review limits</span></h2><p>तपासणी: {checked} (लॉस एंजेलिस दिनांक). स्रोत व नकाशाची तारीख ही प्रत्यक्ष स्थळ तपासणी नाही.</p><p lang="en">Reviewed {checked} (Los Angeles date). A source review or Maps date is not an on-site inspection. Current booking slots, temporary closures and complete physical accessibility are not independently confirmed.</p><ul><li><a href={sources.asi}>Archaeological Survey of India: Ellora Caves</a> — ओळख, ऐतिहासिक श्रेय, वेळा व दर / identity, historical attribution, listed opening and rates.</li><li><a href={sources.unesco}>UNESCO World Heritage Centre: Ellora Caves</a> — समूह, कालखंड, नोंद व स्थान / ensemble, chronology, inscription and property reference.</li><li><a href={sources.tickets}>ASI ticket service</a> — भेटीच्या तारखेसाठी तपासा / check the actual visit date.</li><li><a href={sources.maps}>Google Maps</a> — {checked} झलक / snapshot; not site-collected reviews.</li></ul></div></section>
<section class="section" id="image-credits"><div class="shell"><h2>छायाचित्र स्रोत <span lang="en">Photograph and licence</span></h2><p>Ms Sarah Welch · <a href={sources.photo}>Kailasa temple overview, Ellora.jpg</a> · 2016-09-12 · <a href={sources.license}>CC BY-SA 4.0</a>.</p><p>मूळ 3264 × 2448 मधून वरचा 3264 × 1200 भाग घेतला; खालचे पर्यटक असलेले क्षेत्र वगळले, आकार कमी केला व JPEG संकुचित केले. शेअरिंग चित्रात गडद कडा जोडल्या. हे वर्तमान स्थितीचे किंवा संपूर्ण मंदिराचे दृश्य नाही.</p><p lang="en">Derived from the upper 3264 × 1200 area of the 3264 × 2448 original, excluding the lower visitor areas; resized and JPEG-compressed. The social cover adds dark padding. These are historical upper architectural details, not the full monument or evidence of current conditions. Derivatives retain CC BY-SA 4.0; photographer credit does not imply endorsement or grant additional subject rights.</p></div></section>
</main>
<footer class="section"><div class="shell"><p>स्वतंत्र, अनधिकृत, ना-नफा पर्यटन व शैक्षणिक माहिती मार्गदर्शक; ASI, UNESCO किंवा मंदिर प्रशासनाचे अधिकृत संकेतस्थळ नाही.</p><p lang="en">An independent, unofficial nonprofit tourism and educational information guide, separate from ASI, UNESCO and temple management.</p><section id="privacy"><h2>गोपनीयता <span lang="en">Privacy and services</span></h2><p>या पानावर Google Analytics आपोआप लोड होते; पान, ब्राउझर व उपकरणाच्या वापराची माहिती Google कडे जाऊ शकते आणि कुकीज वापरल्या जाऊ शकतात. येथे संमतीचा किंवा ते बंद करण्याचा स्वतंत्र नियंत्रण नाही.</p><p lang="en">Google Analytics loads automatically on this page. It may use cookies and send page, browser and device-usage information to Google. No site consent or disable control is offered here. <a href="https://policies.google.com/privacy">Google privacy</a> · <a href="https://tools.google.com/dlpage/gaoptout">Google’s external browser opt-out tool</a>.</p><p>२०२६-१०-२९ रोजी उत्पादनाच्या HTML प्रतिसादात Cloudflare Web Analytics स्क्रिप्टची भर दिसली. ही स्क्रिप्ट प्रत्यक्ष लोड झाली किंवा डेटा पाठवला गेला याची त्या निरीक्षणातून खात्री होत नाही. ही सेवा भेटी, पानदृश्ये व कामगिरी मोजू शकते; त्यासाठी येथे स्वतंत्र स्विच नाही. Cloudflare चे जोडणी, सुरक्षा व होस्टिंग-एज डेटा हाताळणे हे ब्राउझर स्क्रिप्टपेक्षा स्वतंत्र असू शकते.</p><p lang="en">Cloudflare Web Analytics script injection was observed in a production HTML response on 2026-10-29. That observation does not establish that the script loaded or sent measurements. The service can measure visits, page views, URL paths, referrers, browser/device information and performance; no site switch for this hosting measurement is offered here. Cloudflare connection, security and edge-hosting data processing can occur independently of the browser script. <a href="https://developers.cloudflare.com/web-analytics/data-metrics/">Cloudflare data documentation</a>.</p><p>हवामानासाठी ब्राउझर Open-Meteo कडे ठरावीक प्रादेशिक बिंदूसाठी विनंती करतो; त्याला IP सारखी जोडणी माहिती मिळते, तुमचे उपकरण-स्थान मागितले जात नाही. प्रतिमा येथूनच दिल्या जातात; Google नकाशा एम्बेड केलेला नाही. बाह्य दुवे उघडल्यावर त्या प्रदात्याचे नियम लागू होतात.</p><p lang="en">The weather panel contacts Open-Meteo from your browser for a fixed regional point; the provider receives connection information such as IP address, without requesting device location. Photos are served by this site; Google Maps is linked rather than embedded. External services apply their policies when opened. <a href="https://open-meteo.com/en/terms">Open-Meteo terms</a>.</p><p>जुना ऑफलाइन कॅश बंद केला आहे; ऑफलाइन उपलब्धतेची हमी नाही. / <span lang="en">The old offline cache is retired; offline availability is not guaranteed.</span></p></section></div></footer>
<script is:inline>if('serviceWorker'in navigator){navigator.serviceWorker.getRegistrations().then(rs=>{for(const r of rs){if(new URL(r.active?.scriptURL||r.installing?.scriptURL||location.origin).pathname==='/sw.js')r.update();}}).catch(()=>{});}</script>
</body></html>
