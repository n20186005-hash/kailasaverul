---
const C={title:'प्रादेशिक हवामान / Regional weather',note:'एलोरा परिसराचा मॉडेल अंदाज; प्रत्यक्ष मंदिर मापन किंवा प्रवेश-सुरक्षा परवानगी नाही. / A regional model near Ellora, not on-site measurement or access/safety clearance.',loading:'नवा अंदाज मागवत आहोत… / Requesting a fresh forecast…',error:'ताजा वैध अंदाज उपलब्ध नाही; जुने किंवा पर्यायी आकडे दाखवलेले नाहीत. / Fresh valid forecast unavailable; old or substitute numbers are not displayed.',temp:'तापमान / Temperature',wind:'वारा / Wind',rain:'दिवसाची कमाल पावसाची शक्यता / Daily maximum rain probability',uv:'दिवसाचा कमाल UV / Daily maximum UV',model:'मॉडेल वेळ / Model time',retrieved:'मागवले / Retrieved',thunder:'वादळी विजेचा मॉडेल संकेत: अधिकृत इशारे व स्थानिक स्थिती तपासा. / Thunder model signal: check official warnings and local conditions.',heavyRain:'जोरदार पावसाचा मॉडेल संकेत: अधिकृत इशारे व मार्ग तपासा. / Heavy-rain model signal: check official warnings and routes.',fog:'धुक्याचा मॉडेल संकेत: रस्त्याची दृश्यता तपासा. / Fog model signal: check road visibility.',limits:'पान सक्रिय असताना १५ मिनिटांनी पुनर्तपासणी; विनंती अयशस्वी झाल्यास आकडे साफ होतात. हवामान कोड आणि पावसाची टक्केवारी वेगळे आहेत; अंदाज सुरक्षित आश्रय किंवा लेणे उघडे असल्याची खात्री देत नाही. / Refreshes every 15 minutes while active; failure clears numbers. Weather intensity and rain probability are separate. A forecast does not identify a safe shelter or confirm a cave is open.'};
const labels:Record<number,string>={0:'निरभ्र / Clear',1:'बहुतेक निरभ्र / Mainly clear',2:'काही ढग / Partly cloudy',3:'ढगाळ / Overcast',45:'धुके / Fog',48:'गोठणारे धुके / Rime fog',51:'हलकी रिमझिम / Light drizzle',53:'रिमझिम / Drizzle',55:'दाट रिमझिम / Dense drizzle',56:'गोठणारी रिमझिम / Freezing drizzle',57:'दाट गोठणारी रिमझिम / Dense freezing drizzle',61:'हलका पाऊस / Light rain',63:'मध्यम पाऊस / Moderate rain',65:'जोरदार पाऊस / Heavy rain',66:'हलका गोठणारा पाऊस / Light freezing rain',67:'जोरदार गोठणारा पाऊस / Heavy freezing rain',71:'हलका हिमपात / Light snow',73:'मध्यम हिमपात / Moderate snow',75:'जोरदार हिमपात / Heavy snow',77:'बर्फकण / Snow grains',80:'हलक्या सरी / Light showers',81:'मध्यम सरी / Moderate showers',82:'जोरदार सरी / Violent showers',85:'हिमवर्षाव सरी / Snow showers',86:'जोरदार हिमवर्षाव सरी / Heavy snow showers',95:'विजांसह वादळ / Thunderstorm',96:'विजा व गारा / Thunderstorm with hail',99:'जोरदार गारांसह वादळ / Thunderstorm with heavy hail'};
---
<section class="section" id="weather"><div class="shell"><h2>{C.title}</h2><p>{C.note}</p><div id="weather-root" aria-live="polite">{C.loading}</div><script id="weather-copy" type="application/json" is:inline set:html={JSON.stringify({C,labels})}/><p class="small">{C.limits}</p><p><a href="https://open-meteo.com/">Open-Meteo</a> · <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a> · <a href="https://mausam.imd.gov.in/">IMD official warnings / अधिकृत इशारे</a></p></div></section>
<script>
import {parseForecast,modelSignal} from '../lib/weather-model';
const root=document.getElementById('weather-root'),copy=document.getElementById('weather-copy');
if(root&&copy){const {C,labels}=JSON.parse(copy.textContent||'{}');let last=0,loading=false;
const el=(tag:string,text:string,cls='')=>{const e=document.createElement(tag);e.textContent=text;e.className=cls;return e;};
const clear=()=>{root.replaceChildren(el('p',C.error,'card'));last=0;};
const load=async()=>{if(loading)return;loading=true;try{const url=new URL('https://api.open-meteo.com/v1/forecast');url.search=new URLSearchParams({latitude:'20.02639',longitude:'75.17917',timezone:'Asia/Kolkata',forecast_days:'7',current:'temperature_2m,weather_code,wind_speed_10m',daily:'weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,uv_index_max'}).toString();const response=await fetch(url,{signal:AbortSignal.timeout(8000)});if(!response.ok)throw Error('status');const report=parseForecast(await response.json());if(!report)throw Error('invalid');const now=report.current,day=report.days[0],card=el('div','','card');card.append(el('h3',`${C.temp}: ${Math.round(now.temperature)}°C`),el('p',labels[now.code]),el('p',`${C.wind}: ${Math.round(now.wind)} km/h`),el('p',`${C.rain}: ${day.probability}%`));if(day.uv!==null)card.append(el('p',`${C.uv}: ${day.uv}`));const signal=modelSignal(now.code);if(signal)card.append(el('p',C[signal],'weather-warning'));card.append(el('p',`${C.model}: ${report.modelTime} · Asia/Kolkata`,'small'),el('p',`${C.retrieved}: ${new Date(report.retrievedAt).toLocaleString('en-IN',{timeZone:'Asia/Kolkata'})}`,'small'));const grid=el('div','','weather-grid');for(const d of report.days){const item=el('div','','card');item.append(el('h3',d.date),el('p',labels[d.code]),el('p',`${Math.round(d.min)}° / ${Math.round(d.max)}°C`),el('p',`${C.rain}: ${d.probability}%`));const signal=modelSignal(d.code);if(signal)item.append(el('p',C[signal],'weather-warning'));grid.append(item);}root.replaceChildren(card,grid);last=Date.now();}catch{clear();}finally{loading=false;}};
load();setInterval(()=>{if(document.visibilityState==='visible')load();else if(last&&Date.now()-last>30*60000)clear();},15*60000);document.addEventListener('visibilitychange',()=>{if(document.visibilityState!=='visible')return;if(last&&Date.now()-last>30*60000)clear();if(!last||Date.now()-last>15*60000)load();});}
</script>
